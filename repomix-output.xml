import React, { useState, useEffect } from 'react';
import {
  View,
  Text,
  StyleSheet,
  Switch,
  TouchableOpacity,
  SafeAreaView,
  StatusBar,
  Platform,
  Alert
} from 'react-native';
import MapView, { Marker, PROVIDER_GOOGLE } from 'react-native-maps';
import { Ionicons } from '@expo/vector-icons';
import { useDriverLocation } from '../hooks/useDriverLocation';
import IncomingRequestModal from '../components/IncomingRequestModal';

const HomeScreen = ({ driverStatus = 'Aprobado', onOpenProfile }) => {
  const [isAvailable, setIsAvailable] = useState(false);
  const { location } = useDriverLocation(isAvailable, driverStatus);
  
  const [incomingRequest, setIncomingRequest] = useState(null);
  const [showModal, setShowModal] = useState(false);

  // Simulación: Generar viaje entrante a los 4 segundos de estar Disponible
  useEffect(() => {
    let timeout = null;
    if (isAvailable && driverStatus === 'Aprobado' && !incomingRequest) {
      timeout = setTimeout(() => {
        const mockTrip = {
          id: 'TRIP_101',
          originAddress: 'Parque Lleras, Poblado',
          destinationAddress: 'Centro Comercial Santafé',
          distanceKm: 6.5,
          durationMin: 18,
          category: 'economy',
          paymentMethod: 'mercadopago',
          tip: 2000
        };
        setIncomingRequest(mockTrip);
        setShowModal(true);
      }, 4000);
    }

    return () => {
      if (timeout) clearTimeout(timeout);
    };
  }, [isAvailable, driverStatus, incomingRequest]);

  const handleToggleAvailability = (value) => {
    if (driverStatus === 'Pendiente') {
      Alert.alert(
        'Cuenta en Revisión',
        'Tu solicitud de registro se encuentra Pendiente de aprobación. No puedes ponerte Disponible hasta que tus documentos sean verificados.'
      );
      setIsAvailable(false);
      return;
    }

    setIsAvailable(value);
    if (!value) {
      setIncomingRequest(null);
      setShowModal(false);
    }
  };

  const handleAcceptTrip = (requestData, fareInfo) => {
    setShowModal(false);
    Alert.alert(
      '¡Viaje Aceptado!',
      `Navegando al origen.\nGanancia Neta: $${fareInfo.driverEarnings.toLocaleString('es-CO')} COP`
    );
  };

  const handleRejectTrip = (reason) => {
    setShowModal(false);
    setIncomingRequest(null);
    if (reason === 'timeout') {
      Alert.alert('Tiempo agotado', 'La solicitud ha sido rechazada automáticamente por el sistema.');
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar barStyle="dark-content" backgroundColor="transparent" translucent />

      {/* Mapa de Fondo */}
      <MapView
        provider={PROVIDER_GOOGLE}
        style={styles.map}
        region={location}
        showsUserLocation={true}
        showsMyLocationButton={false}
      >
        {isAvailable && (
          <Marker
            coordinate={{ latitude: location.latitude, longitude: location.longitude }}
            title="Tu Vehículo"
            description="Estás disponible para recibir carreras"
          >
            <View style={styles.driverMarker}>
              <Ionicons name="car" size={22} color="#FFFFFF" />
            </View>
          </Marker>
        )}
      </MapView>

      {/* Bar de Encabezado Flotante */}
      <View style={styles.topHeader}>
        <TouchableOpacity style={styles.menuButton} onPress={onOpenProfile}>
          <Ionicons name="menu-outline" size={26} color="#0A2540" />
        </TouchableOpacity>

        <View style={styles.headerStatusBadge}>
          <View style={[styles.statusDot, { backgroundColor: isAvailable ? '#22C55E' : '#EF4444' }]} />
          <Text style={styles.headerStatusText}>
            {isAvailable ? 'Disponible' : 'No disponible'}
          </Text>
        </View>
      </View>

      {/* Tarjeta Inferior de Control de Disponibilidad */}
      <View style={styles.bottomCard}>
        <View style={styles.switchRow}>
          <View style={styles.switchInfo}>
            <Text style={styles.switchTitle}>
              {isAvailable ? 'Disponible' : 'No disponible'}
            </Text>
            <Text style={styles.switchSubtitle}>
              {isAvailable
                ? 'Buscando solicitudes de viaje cercanas...'
                : 'Ponte disponible para empezar a recibir viajes.'}
            </Text>
          </View>

          <Switch
            trackColor={{ false: '#CBD5E1', true: '#93C5FD' }}
            thumbColor={isAvailable ? '#0056D2' : '#64748B'}
            ios_backgroundColor="#CBD5E1"
            onValueChange={handleToggleAvailability}
            value={isAvailable}
          />
        </View>
      </View>

      {/* Modal de Solicitud Entrante */}
      <IncomingRequestModal
        visible={showModal}
        requestData={incomingRequest}
        onAccept={handleAcceptTrip}
        onReject={handleRejectTrip}
      />
    </SafeAreaView>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#FFFFFF',
  },
  map: {
    ...StyleSheet.absoluteFillObject,
  },
